package {{.Service.ServiceName | lower}}

import (
	"context"
	"log/slog"

	"github.com/dreamsxin/go-kit/v2/endpoint"
	slogadapter "github.com/dreamsxin/go-kit/v2/observability/slog"
)

// Code generated by microgen. DO NOT EDIT.

// generatedMetricsCollector tallies every generated endpoint into one collector,
// labeled per operation. Metrics reports the collector so the service can read
// the counters; MetricsSnapshotFor reads one operation.
var generatedMetricsCollector = &endpoint.Metrics{}

// Metrics returns the collector the generated middleware chain records into.
// Its Snapshot is the total across operations; SnapshotFor and Operations break
// it down per endpoint.
func Metrics() *endpoint.Metrics { return generatedMetricsCollector }

func generatedMiddlewareChain(logger *slog.Logger, cfg MiddlewareConfig, name string) []endpoint.Middleware {
	// Recovery is outermost so a panic in any generated or custom endpoint
	// middleware becomes a classified 500 instead of crashing the process.
	panicHandler := endpoint.PanicHandler(nil)
	if logger != nil {
		panicHandler = func(ctx context.Context, _ any, recovered any) error {
			logger.ErrorContext(ctx, "endpoint panic", "operation", name, "panic", recovered)
			return endpoint.DefaultPanicHandler(ctx, nil, recovered)
		}
	}
	middlewares := []endpoint.Middleware{endpoint.RecoveryMiddleware(panicHandler)}

{{- range .GeneratedMiddlewares}}
{{- if eq . "tracing"}}
	middlewares = append(middlewares, endpoint.TracingMiddleware())
{{- end}}
{{- if eq . "error-handling"}}
	middlewares = append(middlewares, endpoint.ErrorHandlingMiddleware(name))
{{- end}}
{{- if eq . "metrics"}}
	middlewares = append(middlewares, endpoint.RecordingMiddleware(name, generatedMetricsCollector))
{{- end}}
{{- end}}

	if logger != nil {
		middlewares = append(middlewares, slogadapter.LoggingMiddleware(logger, name))
	}
	if cfg.Timeout > 0 {
		middlewares = append(middlewares, endpoint.TimeoutMiddleware(cfg.Timeout))
	}
	// Innermost: a response that carries its own error through endpoint.Failer
	// reaches the transport with a nil error, so without this the metrics and
	// logging above would record a failed call as a success.
	middlewares = append(middlewares, endpoint.FailerMiddleware())
	return middlewares
}

func applyGeneratedMiddleware(ep endpoint.Endpoint, logger *slog.Logger, cfg MiddlewareConfig, name string) endpoint.Endpoint {
	b := endpoint.NewBuilder(ep)
	for _, mw := range generatedMiddlewareChain(logger, cfg, name) {
		b = b.Use(mw)
	}
	return b.Build()
}
