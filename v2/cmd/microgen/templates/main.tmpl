func main() {
{{if .WithConfig}}	configPath := flag.String("config", "config/config.yaml", "path to config file")
	flag.CommandLine.Parse(filterArgs(os.Args[1:], "-config"))

	cfg, err := config.LoadUnvalidated(*configPath)
	if err != nil {
		panic("FATAL: load config: " + err.Error())
	}

	var (
		httpAddr = flag.String("http.addr", cfg.Server.HTTPAddr, "HTTP listen address")
{{if .WithGRPC}}		grpcAddr = flag.String("grpc.addr", cfg.Server.GRPCAddr, "gRPC listen address")
{{end}}{{if .WithDB}}		dsn = flag.String("db.dsn", cfg.Database.DSN, "{{.DBDriver}} DSN")
		autoMigrate = flag.Bool("auto-migrate", cfg.Database.AutoMigrate, "run database AutoMigrate on startup")
{{end}}	)
	flag.Parse()
	cfg.Server.HTTPAddr = *httpAddr
{{if .WithGRPC}}	cfg.Server.GRPCAddr = *grpcAddr
{{end}}{{if .WithDB}}	cfg.Database.DSN = *dsn
	cfg.Database.AutoMigrate = *autoMigrate
{{end}}	if err := cfg.Validate(); err != nil {
		panic("FATAL: invalid config: " + err.Error())
	}

	logger, err := newConfiguredLogger(cfg.Logging)
	if err != nil {
		panic("FATAL: create logger: " + err.Error())
	}
	logger.Info("config loaded", "path", *configPath)
{{else}}	var (
		httpAddr = flag.String("http.addr", ":8080", "HTTP listen address")
{{if .WithGRPC}}		grpcAddr = flag.String("grpc.addr", ":8081", "gRPC listen address")
{{end}}{{if .WithDB}}		dsn = flag.String("db.dsn", "{{.DBDefaultDSN}}", "{{.DBDriver}} DSN")
		autoMigrate = flag.Bool("auto-migrate", false, "run database AutoMigrate on startup")
{{end}}	)
	flag.Parse()

	logger := slog.New(slog.NewTextHandler(os.Stdout, &slog.HandlerOptions{Level: slog.LevelDebug}))
{{end}}

{{if .WithDB}}	db, err := gorm.Open({{.DBOpenCall}}, &gorm.Config{})
	if err != nil {
		panic(fmt.Sprintf("FATAL: connect database failed: %v", err))
	}
	sqlDB, err := db.DB()
	if err != nil {
		panic(fmt.Sprintf("FATAL: get database handle failed: %v", err))
	}
	defer sqlDB.Close() //nolint:errcheck
{{if .WithConfig}}	sqlDB.SetMaxOpenConns(cfg.Database.MaxOpenConns)
	sqlDB.SetMaxIdleConns(cfg.Database.MaxIdleConns)
	sqlDB.SetConnMaxLifetime(cfg.Database.ConnMaxLifetime)
{{else}}	sqlDB.SetMaxOpenConns(20)
	sqlDB.SetMaxIdleConns(5)
	sqlDB.SetConnMaxLifetime(time.Hour)
{{end}}
	logger.Info("database connected", "driver", "{{.DBDriver}}", "dsn", redactDSN(*dsn))

	repoDB := repository.NewDB(db)
{{end}}

{{if .WithDB}}	generated := initGeneratedServices(logger{{if .WithConfig}}, cfg{{end}}, repoDB)
{{else}}	generated := initGeneratedServices(logger{{if .WithConfig}}, cfg{{end}})
{{end}}	runtime := generated.generatedRuntime()

{{if .WithInteraction}}	interactionRuntime := initInteractionRuntime(&generated)
{{end}}

{{if .WithDB}}	if {{if .WithConfig}}cfg.Database.AutoMigrate{{else}}*autoMigrate{{end}} {
		if err := runtime.autoMigrate(db); err != nil {
			panic(fmt.Sprintf("FATAL: auto migrate failed: %v", err))
		}
		logger.Info("database migration completed")
	} else {
		logger.Info("database migration skipped")
	}
{{end}}

	var ready atomic.Bool
	r := http.NewServeMux()

	// Kubernetes-style probes, matching the routes kit.NewHTTP registers:
	//   /livez  liveness  -- the process is up; restart the container if this fails
	//   /readyz readiness -- the listeners are serving; take the pod out of the
	//                        load balancer if this fails
	//   /health both      -- the convenience route most tooling defaults to
	// ready flips on once both listeners are up and off again at the first sign
	// of shutdown, so a rolling deploy drains connections instead of dropping them.
	healthHandler := func(requireReady bool) http.HandlerFunc {
		return func(w http.ResponseWriter, r *http.Request) {
			w.Header().Set("Content-Type", "application/json")
			if requireReady && !ready.Load() {
				w.WriteHeader(http.StatusServiceUnavailable)
				fmt.Fprintln(w, `{"status":"not_ready","service":"{{range .Project.Services}}{{.Name}}{{end}}"}`)
				return
			}
			w.WriteHeader(http.StatusOK)
			fmt.Fprintln(w, `{"status":"ok","service":"{{range .Project.Services}}{{.Name}}{{end}}"}`)
		}
	}
	for pattern, requireReady := range map[string]bool{"/health": true, "/livez": false, "/readyz": true} {
		handler := healthHandler(requireReady)
		r.HandleFunc("GET "+pattern, handler)
		r.HandleFunc("HEAD "+pattern, handler)
	}

{{if .WithInteraction}}	mcpHandler := mcp.NewStreamableHandler(interactionRuntime)
	r.Handle("GET /mcp", mcpHandler)
	r.Handle("POST /mcp", mcpHandler)
	r.Handle("DELETE /mcp", mcpHandler)
{{end}}

{{if .WithOpenAPI}}	r.HandleFunc("GET /openapi.json", docs.Handler)
	r.HandleFunc("GET /schema.json", docs.SchemaHandler)
	r.Handle("GET /swagger/", swaggerUI.New("{{range .Project.Services}}{{.Name}} {{end}}API", "/openapi.json", "/swagger/"))
{{end}}

{{if .WithConfig}}	// Per-route metrics, when the deployment asked for an endpoint to scrape.
	// Recording is installed at registration because that is the only place a
	// handler and its route pattern are both in scope: middleware wrapped around
	// the mux would record every request with an empty route.
	var routes httpserver.RouteRegistrar = r
	var metricsCollector *endpoint.Metrics
	if cfg.Server.MetricsPath != "" {
		metricsCollector = &endpoint.Metrics{}

		routes = httpserver.DecorateRoutes(r, httpserver.RecordingMiddleware(metrics.HTTPRecorder(metricsCollector)))
		// Mounted on the mux directly, outside the decorator: a scrape reports on
		// the service rather than on itself.
		r.Handle("GET "+cfg.Server.MetricsPath, metrics.Handler(metricsCollector))
		logger.Info("metrics endpoint enabled", "path", cfg.Server.MetricsPath)
	}
	runtime.registerRoutes(routes)
{{else}}	runtime.registerRoutes(r)
{{end}}	// Custom routes are registered on the mux itself: cmd/custom_routes.go is
	// yours, and wrapping handlers you wrote is your call to make there.
	registerCustomRoutes(r)


{{if .WithConfig}}	if cfg.Debug.RoutesEnabled {
		r.HandleFunc("GET /debug/routes", func(w http.ResponseWriter, req *http.Request) {
		w.Header().Set("Content-Type", "application/json; charset=utf-8")
			_ = json.NewEncoder(w).Encode(generatedRouteEntries(runtime, {{if .WithOpenAPI}}true{{else}}false{{end}}, true{{if .WithInteraction}}, true{{end}}))
		})
	}
{{end}}

{{if .WithConfig}}	if cfg.Debug.PrintRoutes {
		allRoutes := generatedRouteEntries(runtime, {{if .WithOpenAPI}}true{{else}}false{{end}}, cfg.Debug.RoutesEnabled{{if .WithInteraction}}, true{{end}})
		printAllRoutes(logger, allRoutes)
	}
{{end}}

	httpServer := &http.Server{
		Addr:         *httpAddr,
		Handler: http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
			start := time.Now()
			r.ServeHTTP(w, req)
			logger.Info("HTTP request", "method", req.Method, "path", req.URL.Path, "duration", time.Since(start))
		}),
{{if .WithConfig}}		ReadTimeout:  cfg.Server.ReadTimeout,
		ReadHeaderTimeout: cfg.Server.ReadHeaderTimeout,
		WriteTimeout: cfg.Server.WriteTimeout,
{{else}}		ReadTimeout:       15 * time.Second,
		ReadHeaderTimeout: 5 * time.Second,
		WriteTimeout:      0,
{{end}}		IdleTimeout:  60 * time.Second,
	}
	serverErr := make(chan error, 2)
{{if .WithConfig}}	// TLS, when the deployment asked this process to terminate it. The pair is
	// loaded before anything is served, so a wrong path or a mismatched key stops
	// startup with the path in the message instead of becoming a handshake error in
	// somebody else's client log. Everything past a minimum version — cipher
	// suites, client certificates — is policy: build a tls.Config here if your
	// deployment has requirements, and see PRODUCTION.md before choosing to
	// terminate here at all.
	//
	// The certificate is asked for on every handshake, so a renewal is picked up by
	// sending this process SIGHUP — no deploy, no restart. See reloadCertificates.
	var certificates *certificateFiles
	if cfg.Server.TLSCertFile != "" {
		loaded, certErr := newCertificateFiles(cfg.Server.TLSCertFile, cfg.Server.TLSKeyFile)
		if certErr != nil {
			panic(fmt.Sprintf("FATAL: %v", certErr))
		}
		certificates = loaded
		httpServer.TLSConfig = &tls.Config{
			MinVersion:     tls.VersionTLS12,
			GetCertificate: certificates.certificate,
		}
	}
{{end}}	httpListener, err := net.Listen("tcp", *httpAddr)


	if err != nil {
		panic(fmt.Sprintf("FATAL: HTTP listen: %v", err))
	}
	defer httpListener.Close() //nolint:errcheck

{{if .WithGRPC}}	lis, err := net.Listen("tcp", *grpcAddr)
	if err != nil {
		panic(fmt.Sprintf("FATAL: gRPC listen: %v", err))
	}
	defer lis.Close() //nolint:errcheck
	// The gRPC port answers the same operational questions the HTTP one does.
	// Trace context is extracted without wiring; the same certificate pair secures
	// both listeners; and the standard health service reports the readiness state
	// the HTTP probes report, so a gRPC-only client has something to check.
	grpcOptions := []grpc.ServerOption{
		grpc.ChainUnaryInterceptor(transportgrpc.TraceparentUnaryServerInterceptor()),
		grpc.ChainStreamInterceptor(transportgrpc.TraceparentStreamServerInterceptor()),
	}
{{if .WithConfig}}	if httpServer.TLSConfig != nil {
		grpcOptions = append(grpcOptions, grpc.Creds(credentials.NewTLS(httpServer.TLSConfig)))
	}
	if metricsCollector != nil {
		// The label is the full method name, which the service definition bounds.
		grpcOptions = append(grpcOptions,
			grpc.ChainUnaryInterceptor(grpcserver.RecordingUnaryInterceptor(metricsgrpc.Recorder(metricsCollector))),
			grpc.ChainStreamInterceptor(grpcserver.RecordingStreamInterceptor(metricsgrpc.Recorder(metricsCollector))),
		)
	}
{{end}}	grpcServer := grpc.NewServer(grpcOptions...)
	grpcHealth := health.NewServer()
	healthpb.RegisterHealthServer(grpcServer, grpcHealth)
	grpcHealth.SetServingStatus("", healthpb.HealthCheckResponse_SERVING)
	runtime.registerGRPCServices(grpcServer)
{{end}}


	go func() {
		// ServeTLS with empty paths: the certificate is already in TLSConfig, and
		// the file arguments are only read when it is not.
		var serveErr error
		if httpServer.TLSConfig != nil {
			serveErr = httpServer.ServeTLS(httpListener, "", "")
		} else {
			serveErr = httpServer.Serve(httpListener)
		}
		if serveErr != nil && serveErr != http.ErrServerClosed {
			serverErr <- fmt.Errorf("HTTP server: %w", serveErr)
		}
	}()


{{if .WithGRPC}}
	go func() {
		if err := grpcServer.Serve(lis); err != nil && err != grpc.ErrServerStopped {
			serverErr <- fmt.Errorf("gRPC server: %w", err)
		}
	}()
{{end}}

	ready.Store(true)
	scheme := "http"
	if httpServer.TLSConfig != nil {
		scheme = "https"
	}
	printBanner(logger, *httpAddr, scheme{{if .WithGRPC}}, *grpcAddr{{end}}, {{if .WithOpenAPI}}true{{else}}false{{end}}{{if .WithInteraction}}, true{{end}})


	runContext, stopSignals := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stopSignals()
{{if .WithConfig}}	if certificates != nil {
		// A renewal is picked up on SIGHUP: the platform that replaced the files is
		// what knows they changed, so it says when to look rather than this process
		// polling. A failed reload is logged and the previous certificate keeps
		// serving — a half-written secret should not cost the listener.
		reloadSignal := make(chan os.Signal, 1)
		signal.Notify(reloadSignal, syscall.SIGHUP)
		defer signal.Stop(reloadSignal)
		go func() {
			for range reloadSignal {
				if reloadErr := certificates.reload(); reloadErr != nil {
					logger.Error("certificate reload failed; still serving the previous certificate", "err", reloadErr)
					continue
				}
				logger.Info("certificate reloaded", "cert", cfg.Server.TLSCertFile, "key", cfg.Server.TLSKeyFile)
			}
		}()
	}
{{end}}	select {

	case <-runContext.Done():
		logger.Info("received shutdown signal")
	case err := <-serverErr:
		logger.Error("server stopped unexpectedly", "err", err)
	}
	// Fail readiness first, so whatever routes traffic here stops sending new
	// requests while the in-flight ones finish draining below.
	ready.Store(false)
{{if .WithGRPC}}	// The gRPC health service answers from its own state, so it has to be told
	// too: a client checking grpc.health.v1 must see NOT_SERVING at the same
	// moment /readyz starts failing.
	grpcHealth.Shutdown()
{{end}}	logger.Info("shutting down")


{{if .WithConfig}}	// Then wait, if asked to. Failing readiness only helps once it has been read:
	// a load balancer or registry refreshes on its own schedule, so closing the
	// listener immediately fails requests that were already routed here.
	if cfg.Server.DrainDelay > 0 {
		logger.Info("draining", "delay", cfg.Server.DrainDelay)
		time.Sleep(cfg.Server.DrainDelay)
	}

	shutdownBudget := cfg.Server.GracefulShutdownTimeout
	if shutdownBudget <= 0 {
		shutdownBudget = 30 * time.Second
	}
{{else}}	shutdownBudget := 30 * time.Second
{{end}}{{if .WithGRPC}}	ctx, cancel := context.WithTimeout(context.Background(), shutdownBudget/2)
{{else}}	ctx, cancel := context.WithTimeout(context.Background(), shutdownBudget)
{{end}}	defer cancel()


	if err := httpServer.Shutdown(ctx); err != nil {
		// The grace period is over and something is still holding a connection —
		// a stream, a long poll, a handler that never watched its context. Close
		// it: returning here would leave the process "stopped" with connections
		// still open.
		logger.Error("HTTP shutdown failed; closing remaining connections", "err", err)
		if closeErr := httpServer.Close(); closeErr != nil {
			logger.Error("HTTP close failed", "err", closeErr)
		}
	}

{{if .WithGRPC}}	// Each server gets its own share of the budget rather than racing for one
	// deadline: with a shared context, a slow HTTP drain leaves gRPC nothing.
	grpcCtx, cancelGRPC := context.WithTimeout(context.Background(), shutdownBudget/2)
	defer cancelGRPC()
	grpcStopped := make(chan struct{})
	go func() {
		grpcServer.GracefulStop()
		close(grpcStopped)
	}()
	select {
	case <-grpcStopped:
		logger.Info("gRPC stopped")
	case <-grpcCtx.Done():
		// Stop cannot preempt a GracefulStop that is still waiting on a handler:
		// the graceful path holds the server's own mutex and Stop needs it. So ask
		// for the hard stop without waiting for it — the process is on its way out,
		// and blocking here is how a "graceful" shutdown becomes a hang.
		go grpcServer.Stop()
		logger.Error("gRPC graceful stop timed out", "err", grpcCtx.Err())
	}

{{end}}	logger.Info("server exited cleanly")

}

