func printBanner(logger *slog.Logger, httpAddr string, scheme string{{if .WithGRPC}}, grpcAddr string{{end}}, withOpenAPI bool{{if .WithInteraction}}, withInteraction bool{{end}}) {
	// An address that is only a port (":8080") needs a host to become a URL; one
	// that already names an interface is used as given.
	base := scheme + "://" + httpAddr
	if strings.HasPrefix(httpAddr, ":") {
		base = scheme + "://localhost" + httpAddr
	}
	logger.Info("starting service", "service", "{{range .Project.Services}}{{.Name}} {{end}}", "http", base)
	if withOpenAPI {
		logger.Info("API documentation", "openapi", base+"/openapi.json", "schema", base+"/schema.json", "ui", base+"/swagger/")
	}
{{if .WithInteraction}}	if withInteraction {
		logger.Info("MCP enabled", "url", base+"/mcp")
	}
{{end}}{{if .WithGRPC}}	logger.Info("gRPC enabled", "address", grpcAddr)
{{end}}	logger.Info("press Ctrl+C to stop")
}


// requestLogger writes one line per request.
//
// It is standard-library middleware installed through the component, which wraps
// every route it serves — generated endpoints, custom handlers, and the probes.
// How a deployment logs is not the framework's decision, so the shape of the line
// lives here.
func requestLogger(logger *slog.Logger) func(http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			start := time.Now()
			next.ServeHTTP(w, r)
			logger.Info("HTTP request", "method", r.Method, "path", r.URL.Path, "duration", time.Since(start))
		})
	}
}


func printAllRoutes(logger *slog.Logger, routes []generatedRouteEntry) {
	logger.Info("registered routes", "count", len(routes))
	for _, route := range routes {
		logger.Info("route", "method", route.Method, "path", route.Path)
	}
}

{{if .WithConfig}}func newConfiguredLogger(cfg config.LoggingConfig) (*slog.Logger, error) {
	encoding := strings.ToLower(strings.TrimSpace(cfg.Format))
	if encoding == "" {
		encoding = "json"
	}
	if encoding != "json" && encoding != "console" {
		return nil, fmt.Errorf("unsupported logging format %q", cfg.Format)
	}

	levelText := strings.ToLower(strings.TrimSpace(cfg.Level))
	if levelText == "" {
		levelText = "info"
	}
	var level slog.Level
	if err := level.UnmarshalText([]byte(levelText)); err != nil {
		return nil, fmt.Errorf("unsupported logging level %q: %w", cfg.Level, err)
	}

	options := &slog.HandlerOptions{Level: level}
	var handler slog.Handler
	if encoding == "console" {
		handler = slog.NewTextHandler(os.Stdout, options)
	} else {
		handler = slog.NewJSONHandler(os.Stdout, options)
	}
	return slog.New(handler), nil
}

{{end}}// main assembles one process around one lifecycle.
//
// Every listener is a kit component, and the Host owns the sequence they run in:
// startup binds or the process exits, readiness fails before anything is torn
// down, the drain delay holds the process open while whatever routes traffic
// notices, and each component then gets a share of the shutdown budget. That
// sequence used to be written out here by hand, which is how a generated service
// ended up with a second copy of a lifecycle the framework already owned — and
// with two of them drifting apart.
func main() {
{{if .WithConfig}}	configPath := flag.String("config", "config/config.yaml", "path to config file")
	flag.CommandLine.Parse(filterArgs(os.Args[1:], "-config"))

	cfg, err := config.LoadUnvalidated(*configPath)
	if err != nil {
		panic("FATAL: load config: " + err.Error())
	}

	var (
		httpAddr = flag.String("http.addr", cfg.Server.HTTPAddr, "HTTP listen address")
{{if .WithGRPC}}		grpcAddr = flag.String("grpc.addr", cfg.Server.GRPCAddr, "gRPC listen address")
{{end}}{{if .WithDB}}		dsn = flag.String("db.dsn", cfg.Database.DSN, "{{.DBDriver}} DSN")
		autoMigrate = flag.Bool("auto-migrate", cfg.Database.AutoMigrate, "run database AutoMigrate on startup")
{{end}}	)
	flag.Parse()
	cfg.Server.HTTPAddr = *httpAddr
{{if .WithGRPC}}	cfg.Server.GRPCAddr = *grpcAddr
{{end}}{{if .WithDB}}	cfg.Database.DSN = *dsn
	cfg.Database.AutoMigrate = *autoMigrate
{{end}}	if err := cfg.Validate(); err != nil {
		panic("FATAL: invalid config: " + err.Error())
	}

	logger, err := newConfiguredLogger(cfg.Logging)
	if err != nil {
		panic("FATAL: create logger: " + err.Error())
	}
	logger.Info("config loaded", "path", *configPath)
{{else}}	var (
		httpAddr = flag.String("http.addr", ":8080", "HTTP listen address")
{{if .WithGRPC}}		grpcAddr = flag.String("grpc.addr", ":8081", "gRPC listen address")
{{end}}{{if .WithDB}}		dsn = flag.String("db.dsn", "{{.DBDefaultDSN}}", "{{.DBDriver}} DSN")
		autoMigrate = flag.Bool("auto-migrate", false, "run database AutoMigrate on startup")
{{end}}	)
	flag.Parse()

	logger := slog.New(slog.NewTextHandler(os.Stdout, &slog.HandlerOptions{Level: slog.LevelDebug}))
{{end}}
	// Signals belong to main. The Host is told to stop by cancelling this context
	// and installs no handlers of its own, which is what keeps "what does Ctrl+C
	// mean" in one place instead of split between a framework and an entry point.
	// Module initialization uses the same context, so a pool that cannot connect is
	// cancelled with the process rather than outliving it.
	runContext, stopSignals := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stopSignals()

	httpOptions := []kit.Option{
		// A request ID is minted or adopted for every request, so a log line and a
		// client's report can be joined.
		kit.WithRequestID(),
		kit.WithHTTPMiddleware(requestLogger(logger)),
		kit.WithHTTPServerConfig(kit.HTTPServerConfig{
{{- if .WithConfig}}
			ReadTimeout:       cfg.Server.ReadTimeout,
			ReadHeaderTimeout: cfg.Server.ReadHeaderTimeout,
			WriteTimeout:      cfg.Server.WriteTimeout,
{{- else}}
			ReadTimeout:       15 * time.Second,
			ReadHeaderTimeout: 5 * time.Second,
{{- end}}
			// Streaming-safe: no write deadline, so a long response is bounded by its
			// own context rather than by the listener.
			IdleTimeout:    60 * time.Second,
			MaxHeaderBytes: 1 << 20,
		}),
	}

{{if .WithConfig}}
	// TLS, when the deployment asked this process to terminate it. The pair is
	// loaded before anything is served, so a wrong path or a mismatched key stops
	// startup with the path in the message instead of becoming a handshake error in
	// somebody else's client log.
	//
	// kit.CertificateFiles is what makes a renewal a signal rather than a deploy:
	// the handshake asks it for the current pair, and SIGHUP tells it to re-read.
	// Everything past a minimum version — cipher suites, client certificates — is
	// policy; see PRODUCTION.md before choosing to terminate here at all.
	var (
		certificates *kit.CertificateFiles
		tlsConfig    *tls.Config
	)
	if cfg.Server.TLSCertFile != "" {
		loaded, certErr := kit.NewCertificateFiles(cfg.Server.TLSCertFile, cfg.Server.TLSKeyFile)
		if certErr != nil {
			logger.Error("load tls certificate", "error", certErr)
			os.Exit(1)
		}
		certificates = loaded
		tlsConfig = &tls.Config{MinVersion: tls.VersionTLS12, GetCertificate: certificates.Certificate}
		httpOptions = append(httpOptions, kit.WithTLSConfig(tlsConfig))
	}

	// Per-route metrics, when the deployment asked for an endpoint to scrape. The
	// component records each route under its own pattern, which is only possible at
	// registration — middleware wrapped around a mux would record every request
	// with an empty route. The probe routes are deliberately not recorded:
	// orchestrator traffic is not application traffic.
	var metricsCollector *endpoint.Metrics
	if cfg.Server.MetricsPath != "" {
		metricsCollector = &endpoint.Metrics{}
		httpOptions = append(httpOptions, kit.WithHTTPRecorder(metrics.HTTPRecorder(metricsCollector)))
	}
{{end}}

	api, err := kit.NewHTTP(*httpAddr, httpOptions...)
	if err != nil {
		logger.Error("http component", "error", err)
		os.Exit(1)
	}

	components := []kit.Lifecycle{api}
{{if .WithInteraction}}	// Attached after the HTTP component, because Shutdown runs in reverse
	// attachment order: closing the MCP sessions is what lets the HTTP drain finish
	// instead of spending its whole budget waiting for an open stream.
	sessions := &sessionCloser{}
	components = append(components, sessions)
{{end}}{{if .WithGRPC}}	// The gRPC listener is a component too. It answers the same operational
	// questions the HTTP one does — the standard health service reports the same
	// readiness, and a stream is told when the process is going away — so both
	// servers run under one startup and one stop sequence.
	var grpcOptions []grpc.ServerOption
{{if .WithConfig}}	if tlsConfig != nil {
		grpcOptions = append(grpcOptions, grpc.Creds(credentials.NewTLS(tlsConfig)))
	}
	if metricsCollector != nil {
		// The label is the full method name, which the service definition bounds.
		grpcOptions = append(grpcOptions,
			grpc.ChainUnaryInterceptor(grpcserver.RecordingUnaryInterceptor(metricsgrpc.Recorder(metricsCollector))),
			grpc.ChainStreamInterceptor(grpcserver.RecordingStreamInterceptor(metricsgrpc.Recorder(metricsCollector))),
		)
	}
{{end}}	grpcComponent, err := kitgrpc.New(*grpcAddr, grpcOptions...)
	if err != nil {
		logger.Error("grpc component", "error", err)
		os.Exit(1)
	}
	components = append(components, grpcComponent)
{{end}}
{{if .WithConfig}}	drainDelay := cfg.Server.DrainDelay
	shutdownTimeout := cfg.Server.GracefulShutdownTimeout
{{else}}	drainDelay := time.Duration(0)
	shutdownTimeout := 30 * time.Second
{{end}}
	hostOptions := []kit.HostOption{
		kit.WithLifecycle(components...),
		// The order these two configure is the whole point of the Host: readiness
		// fails, the process waits long enough for whatever routes traffic to
		// notice, and only then does anything stop.
		kit.WithDrainDelay(drainDelay),
		kit.WithShutdownTimeout(shutdownTimeout),
	}
{{if .WithDB}}	database := &databaseModule{
		dsn:    *dsn,
		logger: logger,
{{if .WithConfig}}		maxOpenConns:    cfg.Database.MaxOpenConns,
		maxIdleConns:    cfg.Database.MaxIdleConns,
		connMaxLifetime: cfg.Database.ConnMaxLifetime,
{{else}}		maxOpenConns:    20,
		maxIdleConns:    5,
		connMaxLifetime: time.Hour,
{{end}}	}
	hostOptions = append(hostOptions, kit.WithModules(database))
{{end}}
	host, err := kit.NewHost(hostOptions...)
	if err != nil {
		logger.Error("assemble host", "error", err)
		os.Exit(1)
	}

	// Init runs before a listener binds, so a module that cannot open what it owns
	// stops the process instead of surfacing as a 500 on the first request. Run
	// initializes again, which is a no-op: this call is what lets the route
	// registration below read the handles the modules published, and registration
	// cannot wait until Run because Run blocks.
	if err := host.Init(runContext); err != nil {
		logger.Error("initialize", "error", err)
		os.Exit(1)
	}
{{if .WithDB}}
	// The handle comes back through the registry rather than a package-level
	// variable: the module that opened the pool is the only thing that knows how,
	// and this is the contract between them.
	repoDB, err := kit.Get[*repository.DB](host.Registry(), databaseRegistryKey)
	if err != nil {
		logger.Error("read database handle", "error", err)
		os.Exit(1)
	}
{{end}}
{{if .WithDB}}	generated := initGeneratedServices(logger{{if .WithConfig}}, cfg{{end}}, repoDB)
{{else}}	generated := initGeneratedServices(logger{{if .WithConfig}}, cfg{{end}})
{{end}}	runtime := generated.generatedRuntime()

{{if .WithInteraction}}	interactionRuntime := initInteractionRuntime(&generated)
{{end}}
{{if .WithDB}}	if {{if .WithConfig}}cfg.Database.AutoMigrate{{else}}*autoMigrate{{end}} {
		if err := runtime.autoMigrate(repoDB); err != nil {
			logger.Error("auto migrate", "error", err)
			os.Exit(1)
		}
		logger.Info("database migration completed")
	} else {
		logger.Info("database migration skipped")
	}
{{end}}
{{if .WithInteraction}}	mcpHandler := mcp.NewStreamableHandler(interactionRuntime)
	sessions.handler = mcpHandler
	// A browser MCP client sends an Origin header, and an origin is only allowed
	// when it is named here. The request's own Host is deliberately not trusted:
	// it comes from the caller, so comparing Origin against it is what DNS
	// rebinding defeats. Name the origins your clients actually use:
	//
	//	mcpHandler.AllowedOrigins = []string{"http://localhost:5173"}
	//
	// Set mcpHandler.TrustRequestHost = true only where Host is trustworthy — a
	// reverse proxy that overwrites it, or a network no browser can reach.
	//
	// Non-browser clients send no Origin and are served without any of this.
	api.Handle("GET /mcp", mcpHandler)
	api.Handle("POST /mcp", mcpHandler)
	api.Handle("DELETE /mcp", mcpHandler)
{{end}}
{{if .WithOpenAPI}}	api.HandleFunc("GET /openapi.json", docs.Handler)
	api.HandleFunc("GET /schema.json", docs.SchemaHandler)
	api.Handle("GET /swagger/", swaggerUI.New("{{range .Project.Services}}{{.Name}} {{end}}API", "/openapi.json", "/swagger/"))
{{end}}
{{if .WithConfig}}	if metricsCollector != nil {
		// Mounted like any other route, on the same port: a scrape reports on the
		// service rather than on itself, and putting it on a second listener is a
		// deployment decision this file would only be guessing at.
		api.Handle("GET "+cfg.Server.MetricsPath, metrics.Handler(metricsCollector))
		logger.Info("metrics endpoint enabled", "path", cfg.Server.MetricsPath)
	}
{{end}}	// Everything below registers on the HTTP component, which is a
	// httpserver.RouteRegistrar: a route added here is served, recorded, and
	// drained like any other.
	runtime.registerRoutes(api)
{{if .WithResource}}	// The declarative surface: every generated table, addressed by the query
	// vocabulary in the resource package instead of by one endpoint per
	// operation. It mounts under its own prefix, because a collection named after
	// its table would answer the pattern a typed endpoint already answers.
	if err := registerResourceRoutes(api, repoDB, "{{.ResourcePrefix}}", resourceAccess()...); err != nil {
		logger.Error("resource routes", "error", err)
		os.Exit(1)
	}
{{end}}	registerCustomRoutes(api)

{{if .WithConfig}}	if cfg.Debug.RoutesEnabled {
		api.HandleFunc("GET /debug/routes", func(w http.ResponseWriter, req *http.Request) {
			w.Header().Set("Content-Type", "application/json; charset=utf-8")
			_ = json.NewEncoder(w).Encode(generatedRouteEntries(runtime, {{if .WithOpenAPI}}true{{else}}false{{end}}, true{{if .WithInteraction}}, true{{end}}))
		})
	}

	if cfg.Debug.PrintRoutes {
		allRoutes := generatedRouteEntries(runtime, {{if .WithOpenAPI}}true{{else}}false{{end}}, cfg.Debug.RoutesEnabled{{if .WithInteraction}}, true{{end}})
		printAllRoutes(logger, allRoutes)
	}
{{end}}
{{if .WithGRPC}}	runtime.registerGRPCServices(grpcComponent.Server())
{{end}}
{{if .WithConfig}}	if certificates != nil {
		// A renewal is picked up on SIGHUP: the platform that replaced the files is
		// what knows they changed, so it says when to look rather than this process
		// polling. A failed reload is logged and the previous certificate keeps
		// serving — a half-written secret should not cost the listener.
		reloadSignal := make(chan os.Signal, 1)
		signal.Notify(reloadSignal, syscall.SIGHUP)
		defer signal.Stop(reloadSignal)
		go func() {
			for range reloadSignal {
				if reloadErr := certificates.Reload(); reloadErr != nil {
					logger.Error("certificate reload failed; still serving the previous certificate", "err", reloadErr)
					continue
				}
				logger.Info("certificate reloaded", "cert", cfg.Server.TLSCertFile, "key", cfg.Server.TLSKeyFile)
			}
		}()
	}
{{end}}
	scheme := "http"
	if api.ServesTLS() {
		scheme = "https"
	}
	// The banner is printed before Run, which is where the listener binds: the
	// address it names is the configured one, and a bind failure is Run's error one
	// line later.
	printBanner(logger, api.Addr(), scheme{{if .WithGRPC}}, *grpcAddr{{end}}, {{if .WithOpenAPI}}true{{else}}false{{end}}{{if .WithInteraction}}, true{{end}})

	if err := host.Run(runContext); err != nil {
		logger.Error("server exited", "error", err)
		os.Exit(1)
	}
	logger.Info("server exited cleanly")
}

{{- if .WithInteraction }}

// sessionCloser closes MCP sessions before the HTTP component stops.
//
// A session holds an open SSE stream, and http.Server.Shutdown waits for open
// connections: without this the drain would spend its whole budget on that stream
// and then fall through to the hard close. It is a component rather than a line in
// main because the Host is what owns the ordering, and components stop in reverse
// attachment order.
type sessionCloser struct {
	handler *mcp.StreamableHandler
}

func (c *sessionCloser) Start() error         { return nil }
func (c *sessionCloser) Errors() <-chan error { return nil }

func (c *sessionCloser) Shutdown(ctx context.Context) error {
	if c.handler == nil {
		return nil
	}
	return c.handler.Shutdown(ctx)
}
{{- end }}

{{- if .WithDB }}

// databaseRegistryKey is the name the database module publishes its handle under.
const databaseRegistryKey = "database"

// databaseModule owns the connection pool.
//
// It is a module rather than a few lines in main because that is the shape the
// Host gives a resource: Init runs before any component starts, so a pool that
// cannot be opened stops the process before it accepts a request, and Shutdown
// runs after every component has stopped, so no handler is mid-query when the
// pool goes away. What it publishes is read back through the Host's registry,
// which is how the code that registers routes gets the handle without a
// package-level variable.
type databaseModule struct {
	dsn             string
	maxOpenConns    int
	maxIdleConns    int
	connMaxLifetime time.Duration
	logger          *slog.Logger

	handle *repository.DB
	pool   *sql.DB
}

func (m *databaseModule) Name() string { return "database" }

func (m *databaseModule) Init(_ context.Context, registry *kit.Registry) error {
	db, err := gorm.Open({{.DBOpener}}(m.dsn), &gorm.Config{TranslateError: true})
	if err != nil {
		return fmt.Errorf("connect database: %w", err)
	}
	pool, err := db.DB()
	if err != nil {
		return fmt.Errorf("get database handle: %w", err)
	}
	pool.SetMaxOpenConns(m.maxOpenConns)
	pool.SetMaxIdleConns(m.maxIdleConns)
	pool.SetConnMaxLifetime(m.connMaxLifetime)
	m.pool = pool
	m.handle = repository.NewDB(db)
	m.logger.Info("database connected", "driver", "{{.DBDriver}}", "dsn", redactDSN(m.dsn))
	return registry.Provide(databaseRegistryKey, m.handle)
}

// Shutdown closes the pool. The Host calls it after every component has stopped,
// so no handler is still holding a connection when it runs.
func (m *databaseModule) Shutdown(context.Context, *kit.Registry) error {
	if m.pool == nil {
		return nil
	}
	return m.pool.Close()
}

func redactDSN(dsn string) string {
	if dsn == "" {
		return ""
	}
	return "<redacted>"
}
{{- end }}
{{- if .WithConfig }}

func filterArgs(args []string, name string) []string {

	var out []string
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == name || arg == "-"+strings.TrimPrefix(name, "-") {
			out = append(out, arg)
			if i+1 < len(args) {
				out = append(out, args[i+1])
				i++
			}
			continue
		}
		if strings.HasPrefix(arg, name+"=") || strings.HasPrefix(arg, "-"+strings.TrimPrefix(name, "-")+"=") {
			out = append(out, arg)
		}
	}
	return out
}
{{- end }}
{{- if .WithResource }}

// resourceAccess is the decision about who may use the declarative surface.
//
// Every generated table is mounted open: anybody who can reach this port may
// list, read, create, change and delete any row. That is what the generator
// ships, because it knows nothing about how your deployment authenticates a
// request — and it is written here as a statement rather than left out as an
// option nobody passed, so it is a line you can find, review and replace.
//
// Replace it before the service is reachable from anywhere you do not control:
//
//	func resourceAccess() []kitrest.Option {
//		return []kitrest.Option{kitrest.WithPolicy(
//			func(ctx context.Context, action kitrest.Action) (kitrest.Decision, error) {
//				subject, ok := auth.Subject(ctx)
//				if !ok {
//					return kitrest.Decision{}, nil // the zero decision refuses
//				}
//				return kitrest.Allow(resource.Params{
//					Filter: resource.Condition("owner_id", resource.OpEq, subject.ID),
//				}), nil
//			})}
//	}
//
// A policy is a whitelist: an action it does not grant is refused. The condition
// it returns travels to the storage in the same statement as the key, so a record
// outside it is answered as missing rather than as somebody else's, and a create
// is checked against it before it is stored.
func resourceAccess() []kitrest.Option {
	return []kitrest.Option{kitrest.WithOpenAccess()}
}
{{- end }}
