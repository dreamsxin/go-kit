{{- if .WithConfig }}

// certificateFiles serves the TLS certificate from disk and can re-read it while the
// process is running, which is what makes a renewal a signal rather than a deploy.
//
// certificate runs on the handshake path, so it returns the pair the last successful
// reload left behind and never touches the filesystem. reload is the call that reads,
// and a failure leaves the previous pair in place.
type certificateFiles struct {
	certFile string
	keyFile  string

	mu      sync.RWMutex
	current *tls.Certificate
}

func newCertificateFiles(certFile, keyFile string) (*certificateFiles, error) {
	files := &certificateFiles{certFile: certFile, keyFile: keyFile}
	if err := files.reload(); err != nil {
		return nil, err
	}
	return files, nil
}

func (f *certificateFiles) reload() error {
	certificate, err := tls.LoadX509KeyPair(f.certFile, f.keyFile)
	if err != nil {
		return fmt.Errorf("load TLS certificate %s and key %s: %w", f.certFile, f.keyFile, err)
	}
	f.mu.Lock()
	f.current = &certificate
	f.mu.Unlock()
	return nil
}

func (f *certificateFiles) certificate(*tls.ClientHelloInfo) (*tls.Certificate, error) {
	f.mu.RLock()
	defer f.mu.RUnlock()
	return f.current, nil
}

func filterArgs(args []string, name string) []string {

	var out []string
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if arg == name || arg == "-"+strings.TrimPrefix(name, "-") {
			out = append(out, arg)
			if i+1 < len(args) {
				out = append(out, args[i+1])
				i++
			}
			continue
		}
		if strings.HasPrefix(arg, name+"=") || strings.HasPrefix(arg, "-"+strings.TrimPrefix(name, "-")+"=") {
			out = append(out, arg)
		}
	}
	return out
}
