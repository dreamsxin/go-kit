// EnforceAuth applies the contract's declared authentication for one
// method: establish the subject, require it, and require any of the roles
// the IDL listed. The generated endpoints call it for every method whose
// IDL declares `auth:`.
func EnforceAuth(ep endpoint.Endpoint, method string, roles []string) endpoint.Endpoint {
	return security.Contract(NewAuthenticator(), roles)(ep)
}

// NewAuthenticator returns the authenticator that establishes the calling
// subject for contract-secured methods. Return nil while unimplemented:
// every secured method then fails closed with 401 auth.not_configured, and
// no request ever runs unauthenticated by accident.
func NewAuthenticator() security.Authenticator { return nil }

type ServiceMiddleware func({{.Service.ServiceName}}) {{.Service.ServiceName}}

func LoggingMiddleware(logger *slog.Logger) ServiceMiddleware {
	return func(next {{.Service.ServiceName}}) {{.Service.ServiceName}} {
		return &loggingMiddleware{next: next, logger: logger}
	}
}

type loggingMiddleware struct {
	next   {{.Service.ServiceName}}
	logger *slog.Logger
}

{{range .UnaryMethods}}
func (m *loggingMiddleware) {{.Name}}(ctx context.Context, req idl.{{.InputName}}) (resp idl.{{.OutputName}}, err error) {
	start := time.Now()
	defer func() {
		if err != nil {
			m.logger.Info("service call failed", "service", "{{$.Service.ServiceName}}", "method", "{{.Name}}", "duration", time.Since(start), "err", err)
		} else {
			m.logger.Info("service call succeeded", "service", "{{$.Service.ServiceName}}", "method", "{{.Name}}", "duration", time.Since(start))
		}
	}()
	return m.next.{{.Name}}(ctx, req)
}
{{end}}
