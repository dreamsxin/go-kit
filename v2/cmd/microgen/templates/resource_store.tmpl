	if errors.Is(err, ErrDuplicated) {
		return apperror.Wrap(apperror.KindAlreadyExists, "resource.duplicate",
			fmt.Sprintf("%s refused the write: a unique value is already taken", s.table), err)
	}
	return s.storageError(operation, err)
}

// The aggregate row shape. The figure and the group columns are aliased so a
// grouped field cannot collide with the computed value in the result map.
const (
	aggregateValueAlias       = "resource_figure"
	aggregateGroupAliasPrefix = "resource_group_"
)

func aggregateGroupAlias(index int) string {
	return aggregateGroupAliasPrefix + strconv.Itoa(index)
}

func orderByColumnsFrom(columns []clause.Column) []clause.OrderByColumn {
	ordered := make([]clause.OrderByColumn, 0, len(columns))
	for _, column := range columns {
		ordered = append(ordered, clause.OrderByColumn{Column: column})
	}
	return ordered
}

func recordsFromRows(rows []map[string]any) []resource.Record {
	records := make([]resource.Record, len(rows))
	for i, row := range rows {
		records[i] = resource.Record(row)
	}
	return records
}

// listOperands reads the operands of a list-valued comparison, tolerating the
// []any a parsed filter carries and the typed slice a caller built in Go.
func listOperands(value any) []any {
	if value == nil {
		return nil
	}
	if list, ok := value.([]any); ok {
		return list
	}
	reflected := reflect.ValueOf(value)
	if reflected.Kind() != reflect.Slice && reflected.Kind() != reflect.Array {
		return nil
	}
	items := make([]any, 0, reflected.Len())
	for i := 0; i < reflected.Len(); i++ {
		items = append(items, reflected.Index(i).Interface())
	}
	return items
}

// escapeLike makes an operand literal for a LIKE pattern. The escape character
// is "!", not the customary backslash: MySQL treats a backslash as an escape
// inside the string literal itself, so the statement that the other two drivers
// parse is the one MySQL rejects.
func escapeLike(text string) string {
	return strings.NewReplacer("!", "!!", "%", "!%", "_", "!_").Replace(text)
}

// The field declarations the per-table files build their schemas from.
//
// Writing and reading are separate capabilities: NewField grants the three a
// declaration implies and leaves writability to the caller, because a column
// whose writability was never considered must not become assignable.
func readOnly(name string, kind resource.FieldType) resource.Field {
	return resource.NewField(name, kind)
}

func writable(field resource.Field) resource.Field {
	field.Writable = true
	return field
}

// opaque declares a field a response may carry and a query may not name: a blob
// or a document has no portable order and no comparison that means the same
// thing on two drivers.
func opaque(name string) resource.Field {
	return resource.Field{Name: name, Type: resource.TypeJSON, Readable: true}
}

// The column converters turn a value that arrived as JSON into the Go type the
// generated model declares for that column.
//
// They exist because a resource record is untyped by design and a gorm insert is
// not. The conversion happens once, at the boundary, and refuses a value the
// column cannot hold instead of truncating it — an int16 silently reduced from
// 70000 is a stored lie.
