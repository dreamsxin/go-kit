		return apperror.Wrap(apperror.KindDeadlineExceeded, "resource.deadline_exceeded",
			fmt.Sprintf("%s could not %s before the deadline", s.table, operation), err)
	}
	return apperror.Wrap(apperror.KindInternal, "resource.storage",
		fmt.Sprintf("%s could not %s the record", s.table, operation), err)
