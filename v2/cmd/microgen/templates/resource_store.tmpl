	if err != nil {
		return 0, err
	}
	converted, err := strconv.ParseInt(text, 10, 64)
	return int(converted), err
}

func columnInt64(value any) (int64, error) {
	text, err := columnText(value)
	if err != nil {
		return 0, err
	}
	return strconv.ParseInt(text, 10, 64)
}

func columnUint(value any) (uint, error) {
	text, err := columnText(value)
	if err != nil {
		return 0, err
	}
	converted, err := strconv.ParseUint(text, 10, 64)
	return uint(converted), err
}

func columnFloat32(value any) (float32, error) {
	text, err := columnText(value)
	if err != nil {
		return 0, err
	}
	converted, err := strconv.ParseFloat(text, 32)
	return float32(converted), err
}

func columnFloat64(value any) (float64, error) {
	text, err := columnText(value)
	if err != nil {
		return 0, err
	}
	return strconv.ParseFloat(text, 64)
}

func columnString(value any) (string, error) {
	return columnText(value)
}

func columnBool(value any) (bool, error) {
	if converted, ok := value.(bool); ok {
		return converted, nil
	}
	text, err := columnText(value)
	if err != nil {
		return false, err
	}
	return strconv.ParseBool(text)
}

func columnBytes(value any) ([]byte, error) {
	switch typed := value.(type) {
	case []byte:
		return typed, nil
	case string:
		return []byte(typed), nil
	}
	text, err := columnText(value)
	return []byte(text), err
}

func columnTime(value any) (time.Time, error) {
	converted, err := resource.NormalizeValue(resource.TypeTime, value)
	if err != nil {
		return time.Time{}, err
	}
	return converted.(time.Time), nil
}

// columnError names the column whose value could not be converted. The cause
// says what arrived; the code says what the caller can do about it.
func columnError(name string, err error) error {
	return apperror.Wrap(apperror.KindInvalidArgument, "resource.field_value",
		fmt.Sprintf("field %q: %v", name, err), err)
}
