module {{.ImportPath}}

go 1.25.8

require (
	github.com/dreamsxin/go-kit/v2 {{.GoKitVersion}}
	{{- if .WithGRPC}}
	github.com/dreamsxin/go-kit/v2/integrations/grpc v0.2.6
	{{- end}}
	{{- if .WithOpenAPI}}
	github.com/swaggest/swgui v1.8.9
	{{- end}}
	{{- if or .WithModel .WithDB}}
	gorm.io/gorm v1.31.1
	{{- end}}
{{- if .WithConfig}}
	gopkg.in/yaml.v3 v3.0.1
{{- end}}
)

{{if .RootRelPath}}
replace github.com/dreamsxin/go-kit/v2 => {{printf "%q" .RootRelPath}}

{{if .WithGRPC}}
replace github.com/dreamsxin/go-kit/v2/integrations/grpc => {{printf "%q" (printf "%s/integrations/grpc" .RootRelPath)}}
{{end}}
{{end}}
