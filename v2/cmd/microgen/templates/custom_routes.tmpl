package main

import httpserver "github.com/dreamsxin/go-kit/v2/transport/http/server"

// registerCustomRoutes is the user-owned hook for project-specific HTTP routes.
// Add handlers here; microgen will not overwrite this file on rerun.
//
// The hook takes the HTTP component's registrar, so a custom route is served,
// recorded, and drained exactly like a generated one — and a pattern that collides
// with a generated route fails at startup instead of being shadowed silently.
// Standard-library handlers are all it needs: Handle and HandleFunc are the same
// two methods a *http.ServeMux offers.
//
// To surface custom routes in /debug/routes and the startup route listing,
// describe them in customRouteDescriptions.
func registerCustomRoutes(r httpserver.RouteRegistrar) {
	_ = r
}

// customRouteDescriptions is the user-owned hook describing custom routes for
// the debug route listing (config mode). Return entries as "METHOD /path",
// for example "GET /custom/ping".
func customRouteDescriptions() []string {
	return nil
}
