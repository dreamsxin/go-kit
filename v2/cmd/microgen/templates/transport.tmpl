package {{.Service.ServiceName | lower}}

import (
{{- if .UnaryMethods}}
	"context"
{{- end}}
	"net/http"


{{- if .UnaryMethods}}
	transporthttp "github.com/dreamsxin/go-kit/v2/transport/http"
{{- end}}
{{- if .UnaryMethods}}
	"github.com/dreamsxin/go-kit/v2/transport/http/server"
	idl "{{if eq .Source "proto"}}{{.ImportPath}}/pb{{else}}{{.ImportPath}}{{end}}"
{{- end}}
	genendpoint "{{.ImportPath}}/endpoint/{{.Service.ServiceName | lower}}"
)

// NewHTTPHandler returns the generated HTTP handler set.
func NewHTTPHandler(endpoints genendpoint.{{.Service.ServiceName}}Endpoints) http.Handler {
	m := http.NewServeMux()
	registerHTTPServeMuxRoutes(m, endpoints)
	return m
}

// RegisterHTTPRoutes binds the generated HTTP routes onto anything that
// registers routes: *http.ServeMux, or a decorator that wraps each handler as it
// is registered. Per-route middleware has to be installed here, because
// registration is the only point where a handler and its route pattern are both
// in scope.
func RegisterHTTPRoutes(router server.RouteRegistrar, endpoints genendpoint.{{.Service.ServiceName}}Endpoints, prefix string) {

{{range .UnaryMethods}}
	// {{.HTTPMethod}} {{.Route}}
	router.Handle("{{.HTTPMethod | upper}} "+routePath(prefix, "{{.Route}}"), server.NewServer(
		endpoints.{{.Name}}Endpoint,
		decode{{.Name}}Request,
		encode{{.Name}}Response,
		server.ServerErrorEncoder(server.JSONErrorEncoder),
		server.ServerBefore(transporthttp.ExtractTraceparent),
	))
{{end}}
}

func registerHTTPServeMuxRoutes(m *http.ServeMux, endpoints genendpoint.{{.Service.ServiceName}}Endpoints) {
{{range .UnaryMethods}}
	m.Handle("{{.HTTPMethod | upper}} {{.Route}}", server.NewServer(
		endpoints.{{.Name}}Endpoint,
		decode{{.Name}}Request,
		encode{{.Name}}Response,
		server.ServerErrorEncoder(server.JSONErrorEncoder),
		server.ServerBefore(transporthttp.ExtractTraceparent),
	))
{{end}}
}

func routePath(prefix, route string) string {
	if prefix == "" {
		return route
	}
	return prefix + route
}

{{range .UnaryMethods}}
// decode{{.Name}}Request uses the generated method-aware decode path.
func decode{{.Name}}Request(_ context.Context, r *http.Request) (any, error) {
	var req idl.{{.InputName}}
{{- if eq (.HTTPMethod | lower) "get"}}
	if err := transporthttp.DecodeQueryRequest(r, &req); err != nil {
		return nil, err
	}
{{- else}}
	if err := server.DecodeJSONBody(r, &req, server.StrictJSONDecodeOptions(server.DefaultMaxJSONBodyBytes)); err != nil {
		return nil, server.JSONDecodeError{Err: err}
	}
	if err := transporthttp.DecodePathRequest(r, &req); err != nil {
		return nil, err
	}
{{- end}}
	return req, nil
}

// encode{{.Name}}Response delegates to the framework encoder rather than calling
// json.NewEncoder directly. Encoding by hand sets no Content-Type — so net/http
// sniffs the body and answers text/plain for JSON, contradicting the OpenAPI
// document this generator writes beside it — and it writes the body before any
// StatusCoder or Headerer on the response type has been consulted, which pins
// every answer to an implicit 200 and loses the 204-no-body rule.
func encode{{.Name}}Response(ctx context.Context, w http.ResponseWriter, response any) error {
	return server.EncodeJSONResponse(ctx, w, response)
}

{{end}}
